<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <group
                android:name="tri_group"
                android:pivotX="54"
                android:pivotY="54"
                android:scaleX="1"
                android:scaleY="1"
                android:rotation="0">
                <path
                    android:fillColor="#8AB4F8"
                    android:fillAlpha="0.22"
                    android:pathData="M54,16 L87,73 L21,73 Z"/>
                <path
                    android:strokeColor="#8AB4F8"
                    android:strokeWidth="3.2"
                    android:strokeLineJoin="round"
                    android:fillColor="#00000000"
                    android:pathData="M54,26 L79,68 L29,68 Z"/>
            </group>
        </vector>
    </aapt:attr>

    <!-- Уменьшение до нуля -->
    <target android:name="tri_group">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="1.0"
                    android:valueTo="0.08"
                    android:startOffset="0"
                    android:duration="600"
                    android:interpolator="@android:interpolator/accelerate_decelerate"/>
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="1.0"
                    android:valueTo="0.08"
                    android:startOffset="0"
                    android:duration="600"
                    android:interpolator="@android:interpolator/accelerate_decelerate"/>
                <objectAnimator
                    android:propertyName="rotation"
                    android:valueFrom="0"
                    android:valueTo="180"
                    android:startOffset="0"
                    android:duration="600"
                    android:interpolator="@android:interpolator/accelerate_decelerate"/>
                <!-- Пауза в миниатюрном состоянии (600–900ms) -->
                <!-- Увеличение обратно -->
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0.08"
                    android:valueTo="1.0"
                    android:startOffset="900"
                    android:duration="600"
                    android:interpolator="@android:interpolator/overshoot"/>
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0.08"
                    android:valueTo="1.0"
                    android:startOffset="900"
                    android:duration="600"
                    android:interpolator="@android:interpolator/overshoot"/>
                <objectAnimator
                    android:propertyName="rotation"
                    android:valueFrom="180"
                    android:valueTo="360"
                    android:startOffset="900"
                    android:duration="600"
                    android:interpolator="@android:interpolator/overshoot"/>
            </set>
        </aapt:attr>
    </target>

</animated-vector>