    <string name="settings_prediction_cooldown_desc">How long the app waits before adding a new recognized letter. Bigger value = fewer accidental repeats.</string>
    <string name="settings_required_matches_desc">How many same predictions in a row are needed before letter is accepted. Bigger value = more stable, but slower.</string>
    <string name="settings_frame_interval_desc">How often live camera frames are analyzed. Smaller value = faster reaction, but more device load.</string>
    <string name="settings_confidence_threshold_desc">Minimum confidence for live prediction. Bigger value = stricter and cleaner results, but may skip some letters.</string>
    <string name="settings_photo_confidence_threshold_desc">Main confidence threshold for recognition from photos. Increase it if wrong letters appear too often.</string>
    <string name="settings_video_confidence_threshold_desc">Extra lower threshold used as fallback for video frames. Helps catch hard frames when main threshold is too strict.</string>
    <string name="settings_video_frame_interval_desc">Step between analyzed video frames. Smaller step = better coverage, bigger step = faster processing.</string>
    <string name="settings_video_resize_mode_desc">How video is shown in preview. Fit shows full frame with borders; Fill crops edges but removes empty space.</string>
    <string name="settings_single_frame_timeout">Single frame recognition timeout</string>
    <string name="settings_single_frame_timeout_desc">Maximum wait time for paused-frame recognition. If exceeded, app shows a failed recognition dialog.</string>
